{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^ai$": "<rootDir>/stubs/esm-only-stub.ts",
    "^@ai-sdk/.*$": "<rootDir>/stubs/esm-only-stub.ts"
  },
  "testPathIgnorePatterns": [
    "/node_modules/",
    "app.e2e-spec.ts"
  ]
}
